# FraudGuard-AI Environment Variables
# Copy this file to .env.local and fill in your values

# ─── MongoDB Atlas ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fraud_detection?retryWrites=true&w=majority
DB_NAME=fraud_detection

# ─── AI / LLM Providers ──────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Remote AI Server (Kamatera) ──────────────────────────────
AI_SERVER_URL=http://your-server-ip:8000/v1

# ─── Kafka Brokers ────────────────────────────────────────────
KAFKA_BROKER=your-kafka-broker-1:9094,your-kafka-broker-2:9094

# ─── Python ML API ────────────────────────────────────────────
PYTHON_API_URL=http://localhost:8000

# ─── Ollama Local LLM (Optional) ─────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
